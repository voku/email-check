{
    source: {
        directories: [
            "src"
        ]
    },
    timeout: 10,
    phpUnit: {
        customPath: "vendor/bin/phpunit"
    },
    phpStan: {
        customPath: "tools/infection/vendor/bin/phpstan"
    },
    staticAnalysisTool: "phpstan",
    minMsi: 0,
    minCoveredMsi: 0,
    logs: {
        summary: "build/infection-summary.log"
    }
}
